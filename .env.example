# 复制为 .env

LOG_LEVEL=INFO
SERVER_LOG_LEVEL=WARNING
LOG_ID_CHARS=8
LOG_FORMAT=<green>{time:YYYY-MM-DD HH:mm:ss}</green> | <level>{level: <7}</level> | <level>{message}</level>
# LOG_LOC_SHORT=true

# uvicorn API（默认不热重载；开发可设 UVICORN_RELOAD=true）
# UVICORN_HOST=0.0.0.0
# UVICORN_PORT=9099
# UVICORN_RELOAD=false
# UVICORN_RELOAD_DIRS=app/api,app/core,app/services,app/schemas

# Redis：Celery broker + 媒体任务状态
REDIS_URL=redis://localhost:6379/0
CELERY_WORKER_CONCURRENCY=3
CELERY_WORKER_SOFT_SHUTDOWN_TIMEOUT=15
# TTS 模型空闲多久后从 GPU 卸载；0 表示任务结束立即卸载
TTS_PIPELINE_IDLE_SEC=120
# 注册哪些 Celery 任务包：sing | chat | tts | fast | all | media（逗号分隔）
# 默认 sing,tts,chat；需 uv sync --all-groups --extra cpu|gpu
CELERY_TASK_PACKAGES=sing,tts,chat
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_TIME_LIMIT=900
# fast worker（随机播放/点歌）并发；I/O 密集，通常高于 media
# CELERY_FAST_WORKER_CONCURRENCY=6

# ── GPU 调度（单卡部署重点）─────────────────────────────────────────────
GPU_LOCK_WAIT_TIMEOUT=60
GPU_LOCK_LEASE_TTL=120
GPU_LOCK_MAX_HOLD=1800
MEDIA_DEVICE=auto

CALLBACK_HOST=localhost
CALLBACK_PORT=8088

# Bot WebUI「AI 服务」Bearer Token 须与此一致；配置后 GET /api/ops/logs 等运维接口需鉴权。
# PALLAS_AI_API_TOKEN=

# ── Image Runtime（Bot draw 插件 ai_service_runtime 模式调用）────────
# IMAGE_ENABLED=false
# IMAGE_BASE_URL=https://api.openai.com
# IMAGE_API_KEY=
# IMAGE_MODEL=gpt-image-1
# IMAGE_REQUEST_TIMEOUT=180
# IMAGE_OPEN_CIRCUIT_FAILURES=3
# IMAGE_CIRCUIT_COOLDOWN_SEC=120
# IMAGE_OMIT_RESPONSE_FORMAT=true
# IMAGE_REF_DOWNLOAD_TIMEOUT=60

# ── Media Tasks（慢路径 image.generate / media.sing 统一任务模型）────
# POST /api/media/tasks
# GET /api/media/tasks/{task_id}
# GET /api/media/tasks/runtime
# MEDIA_TASK_TTL_SEC=86400
